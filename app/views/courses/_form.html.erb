<%= form_with(model: course, local: true) do |form| %>
  <% if course.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h2>

      <ul>
        <% course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <!-- Dropdown to choose CodingClass -->
  <div>
    <%= form.label :coding_class_id, "Coding class", style: "display: block" %>
    <%= form.collection_select(:coding_class_id,
          @coding_classes, :id, :title,
          { prompt: "Select coding class" }) %>
  </div>

  <!-- Dropdown for Trimester -->
  <div>
    <%= form.label :trimester_id, "Trimester", style: "display: block" %>
    <%= form.collection_select(
          :trimester_id,
          @trimesters, :id, :display_name,
          { prompt: "Select trimester" }
        ) %>
  </div>

   <div style="margin-top: 1em;">
    <%= form.label :max_enrollment, style: "display: block" %>
    <%= form.number_field :max_enrollment, class: "form-control" %>
  </div>

  <!-- Submit button -->
  <div style ='margin-top: 1e;'>
    <%= form.submit "Save Course", class: "btn btn-primary"%>
  </div>
<% end %>
